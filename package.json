{
  "name": "koishi-plugin-giveaway",
  "description": "A versatile giveaway plugin for Koishi: interactive giveaway creation, scheduled auto-draw, reminders, i18n and multi-timezone support.",
  "version": "0.1.0",
  "contributors": [
    "Logthm <logthm@outlook.com>",
    "firedrakeovo"
  ],
  "homepage": "https://github.com/firedrakeovo/koishi-plugin-giveaway",
  "bugs": {
    "url": "https://github.com/firedrakeovo/koishi-plugin-giveaway/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/firedrakeovo/koishi-plugin-giveaway.git"
  },
  "main": "lib/index.js",
  "typings": "lib/index.d.ts",
  "files": [
    "lib",
    "dist"
  ],
  "scripts": {
    "build": "npm run build:types && node scripts/build.mjs",
    "build:types": "tsc -p tsconfig.json",
    "build:watch": "node scripts/build.mjs --watch",
    "clean": "node -e \"require('node:fs').rmSync('lib', { recursive: true, force: true })\"",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "keywords": [
    "chatbot",
    "koishi",
    "plugin",
    "lottery",
    "giveaway",
    "raffle",
    "draw",
    "抽奖"
  ],
  "peerDependencies": {
    "koishi": "^4.18.0"
  },
  "dependencies": {
    "luxon": "^3.5.0",
    "node-schedule": "^2.1.1"
  },
  "devDependencies": {
    "@koishijs/plugin-database-memory": "^3.6.0",
    "@types/luxon": "^3",
    "@types/node": "^22.7.5",
    "@types/node-schedule": "^2",
    "esbuild": "^0.23.1",
    "js-yaml": "^4.1.0",
    "koishi": "^4.18.7",
    "koishi-plugin-assets-local": "^3.3.2",
    "typescript": "^5.6.2",
    "yml-register": "^1.2.5"
  },
  "koishi": {
    "description": {
      "de": "Bietet eine Lotteriefunktion, einschließlich automatischer Ziehungen und geplanter Erinnerungen, und unterstützt mehrere Sprachen und Zeitzonen.",
      "en": "A versatile giveaway plugin: interactive giveaway creation, scheduled auto-draw and reminders, with multi-language and multi-timezone support.",
      "zh": "群抽奖插件：交互式创建抽奖、定时自动开奖与提醒，支持多种语言和时区。"
    },
    "service": {
      "required": [
        "database",
        "assets"
      ]
    },
    "locales": [
      "de",
      "en",
      "zh"
    ]
  }
}
